<?xml version="1.0" encoding="utf-8"?>
<!-- Keep managed-radio configuration on the provisioning device only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="radio-config/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="radio-config/" />
    </device-transfer>
</data-extraction-rules>
