<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <application
        android:allowBackup="false"
        android:label="Minimum Wi-Fi Provisioner"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".WifiProvisionActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <receiver
            android:name=".WifiProvisionReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.minimum.wifiprovisioner.action.IMPORT_REQUEST" />
                <action android:name="dev.minimum.wifiprovisioner.action.STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
